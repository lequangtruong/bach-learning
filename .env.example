# Chỉ dùng cho local/Vercel Environment Variables; không commit secret thật.
GEMINI_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
GEMINI_CLIENT_SECRET=replace-in-vercel-only
GEMINI_REFRESH_TOKEN=replace-in-vercel-only
GEMINI_PROJECT_ID=your-google-cloud-project-id
GOOGLE_TUTOR_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
BACH_ALLOWED_EMAIL=parent@example.com
GEMINI_MODEL=gemini-2.5-flash

# Local-only optional developer fallback. Không bật trên Vercel.
BACH_ENABLE_AGY_FALLBACK=0
